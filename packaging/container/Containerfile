# Canoa's host and web app, built in a container from Boriken Dev's own mirrors:
#
#   Flutter     the image ghcr.io/boriken-dev/flutter-web for the pin in tools/flutter.pin: Boriken-Dev/flutter's checkout (the
#               scanner-clean mirror of Flutter main) with the engine, the Dart SDK and the web artifacts of the mirror's release
#   every crate, pub package, fallback font and Office.js file
#               the `deps` branch of github.com/Boriken-Dev/canoa at DEPS_COMMIT
#               (also the app's git packages, as source trees at the revisions app/pubspec.lock names, and the
#               crates of app/web_noise and of wasm-bindgen's command line, each folder with its own lock)
#
#   sh packaging/container/build.sh                 # the image `canoa`, and canoa and site/ copied into ./out
#   sh packaging/container/build.sh --print         # the command, nothing run
#   podman run --rm canoa --version
#
# `docker` works the same (CONTAINER_ENGINE=docker). Build from the repository root with the root as the context
# (`.containerignore` leaves out what a build never reads).
#
# What uses the network, by stage. `--network=none` marks the steps that run with it off.
#   base      the base image and Debian packages (docker.io, deb.debian.org)
#   flutter   the Flutter image (ghcr.io) and Debian's python3. Flutter's storage is pointed at a dead address, so a build that
#             asked Google for anything fails
#   deps      the deps branch, from github.com/Boriken-Dev
#   wasm_target  rustup's wasm32 target, from static.rust-lang.org
#   noise     offline: installing wasm-bindgen's command line and building app/web_noise, from the deps branch's
#             crates-wasm-bindgen-cli/ and crates-web_noise/
#   site      offline: the hosted and git packages come from the deps branch
#   host      the Debian packages for compiling whisper.cpp (cmake, libclang-dev), then offline: the crates come from the deps branch
# Nothing else is fetched (nothing from Google or pub.dev): once base, flutter, deps and wasm_target are built, `podman build --network=none` builds the
# rest. The image holds no credential, and the stages that fetch are not copied into `runtime`.
#
# An x86-64 build needs nothing different: the bases are multi-architecture, Flutter's Dart SDK and the
# wasm-bindgen build take the machine's own, and the site is architecture-independent. Build it on an x86-64 machine,
# or with `--platform linux/amd64` under emulation, slowly.

ARG BASE_IMAGE=docker.io/library/rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff
ARG RUNTIME_IMAGE=docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# The image of the Flutter SDK named in tools/flutter.pin: the first ten digits of its FLUTTER_COMMIT (build.sh passes the
# pin's; tools/flutter_pin.py check fails when this default is another).
ARG FLUTTER_IMAGE_TAG=33d7f282aa
# The deps branch at the commit that mirrors main's Cargo.lock and app/pubspec.lock (its manifest.json names the source).
ARG DEPS_COMMIT=9bd63bf2ddb3e0f6462bc5104e0c61a017398095

FROM ${BASE_IMAGE} AS base
ENV DEBIAN_FRONTEND=noninteractive
# git and python3 (3.11 or later, for tools/mirror_crates.py) are in the Rust image; unzip and xz are Flutter's.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git python3 unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# The Flutter SDK: Boriken Dev's image for the pin, which holds the mirror's checkout with every tag, the engine, the Dart
# SDK and the web artifacts precached from the mirror's release, so nothing here asks Flutter's storage or flutter/flutter
# for anything (the image is the Debian toolchain of github.com/Boriken-Dev/flutter-images). Only Debian's python3 is added,
# for the site's build script. The storage address is a dead one: a step that needed Google's storage fails, it does not
# fetch. Nothing of the app is here, so this layer is reused until FLUTTER_IMAGE_TAG or the image changes.
FROM ghcr.io/boriken-dev/flutter-web:${FLUTTER_IMAGE_TAG} AS flutter
USER root
ENV DEBIAN_FRONTEND=noninteractive FLUTTER_GIT_URL=https://github.com/Boriken-Dev/flutter.git     FLUTTER_STORAGE_BASE_URL=http://127.0.0.1:9 CI=true
RUN apt-get update     && apt-get install -y --no-install-recommends python3     && rm -rf /var/lib/apt/lists/*     && git config --system --add safe.directory '*'
RUN flutter --version

# The deps branch at DEPS_COMMIT, fetched by commit so a moved branch changes nothing.
FROM base AS deps
ARG DEPS_COMMIT
ARG DEPS_REPOSITORY=https://github.com/Boriken-Dev/canoa.git
RUN set -eu; \
    git init --quiet /deps; \
    git -C /deps fetch --quiet --depth 1 "${DEPS_REPOSITORY}" "${DEPS_COMMIT}"; \
    git -C /deps checkout --quiet --detach FETCH_HEAD; \
    [ "$(git -C /deps rev-parse HEAD)" = "${DEPS_COMMIT}" ]; \
    rm -rf /deps/.git

# The Rust image with the target the Noise method compiles for, from rustup: the one step of the Rust side that fetches.
FROM base AS wasm_target
RUN rustup target add wasm32-unknown-unknown

# wasm-bindgen's command line and the web app's Noise method, which the page loads as WebAssembly, built from the deps
# branch's own folders for them (the Noise crate has a lock of its own, so its crates are not the host's). They depend
# on app/web_noise, tools/, the build scripts and the deps branch only, so a change elsewhere in the source leaves this layer alone.
FROM wasm_target AS noise
ENV CANOA_DEPS=/deps CARGO_NET_OFFLINE=true
WORKDIR /src
COPY --from=deps /deps /deps
COPY tools tools
COPY app/tool/build_noise.py app/tool/offline_pub.py app/tool/
COPY app/web_noise app/web_noise
RUN --network=none python3 app/tool/build_noise.py --install-bindgen
RUN --network=none CARGO_TARGET_DIR=/tmp/noise-target python3 app/tool/build_noise.py --out /out/noise \
    && rm -rf /tmp/noise-target

# The web app, built the way build.py builds it for the host: --csp, no service worker, the fallback fonts from the
# deps branch (a missing or changed one stops the build).
FROM flutter AS site
ENV CANOA_DEPS=/deps PUB_CACHE=/opt/pub-cache
WORKDIR /src
COPY --from=deps /deps /deps
COPY app app
COPY tools tools
COPY packaging/container/site_build.py packaging/container/site_build.py
COPY Cargo.lock Cargo.toml ./
COPY --from=noise /out/noise app/web/noise
RUN --network=none python3 packaging/container/site_build.py

# The host, with the site and Office.js built in, from the deps branch's crates alone.
FROM base AS host
# whisper.cpp is compiled into the host by cmake (`whisper-rs-sys`), with the C++ compiler the Rust image has and libclang for the
# bindings. The only fetch of this stage; the build steps below run offline.
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake libclang-dev \
    && rm -rf /var/lib/apt/lists/*
# ggml's baseline for the program built here: not the builder's own CPU, which may have more than the machine it runs on.
ENV CANOA_DEPS=/deps CARGO_NET_OFFLINE=true GGML_NATIVE=OFF GGML_AVX2=ON GGML_FMA=ON GGML_F16C=ON GGML_BMI2=ON
WORKDIR /src
COPY --from=deps /deps /deps
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY extensions extensions
# The vendored whisper-rs-sys: whisper.cpp 1.9.6, where the published crate carries an older one.
COPY third_party third_party
COPY examples examples
# The host embeds pages and scripts of the browser extension and the Office add-in.
COPY clients clients
COPY tools tools
COPY --from=site /src/app/build/web /site
# The cargo home whose config replaces crates.io and every git source by /deps/crates; it refuses a lock the folder
# does not cover.
RUN --network=none python3 tools/mirror_crates.py use /deps --out /opt/cargo-offline
RUN --network=none CANOA_WEB_DIST=/site cargo --config /opt/cargo-offline/config.toml build --release --locked --offline -p canoa-host --bin canoa \
    && strip target/release/canoa \
    && target/release/canoa --version

# What build.sh copies out: the program and the site it serves.
FROM scratch AS out
COPY --from=host /src/target/release/canoa /canoa
COPY --from=site /src/app/build/web /site

FROM ${RUNTIME_IMAGE} AS runtime
RUN groupadd --system --gid 10001 canoa \
    && useradd --system --uid 10001 --gid canoa --create-home --home-dir /home/canoa --shell /usr/sbin/nologin canoa
COPY --from=host /src/target/release/canoa /usr/local/bin/canoa
USER canoa
ENV HOME=/home/canoa
VOLUME /home/canoa
ENTRYPOINT ["canoa"]
