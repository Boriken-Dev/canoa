# Dotfiles at the root are opt-in.
/.*
!/.gitignore
!/.gitattributes
!/.containerignore
!/.github/

# Agent config and personal overrides, at any depth.
.agents
CLAUDE*
# On a case-insensitive filesystem CLAUDE* also matches these files, which are not agent config.
!app/assets/icons/agents/claude.svg
!app/test/fixtures/claude_subagent_updates.json
!extensions/canoa-claude/looks/claude.json
!app/test/goldens/claude_*.png
.claude
*.local.*

# Rust. The workspace builds a binary, canoa, so its lockfile is committed.
/target/

# Node
node_modules/

# Python: a Guatiao source's interpreter writes bytecode beside a provider's modules, whatever the environment says.
__pycache__/

# Flutter
/app/.dart_tool/
/app/build/
/app/.flutter-plugins*

# Runners `flutter create` generates (python app/tool/build.py desktop); never committed
/app/windows/
/app/linux/
/app/macos/
/app/.metadata
/app/.gitignore

# Built extension UI
/clients/browser/chromium/ui/
/clients/browser/firefox/ui/

# Docs build
/site/

# Secrets and OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Generated by app/tool/build_noise.py
/app/web/noise/
/app/test/noise/
/app/web_noise/target/
# Generated by app/tool/build_whisper.py
/app/web/whisper/
/app/web_whisper/target/
app/test/failures/
