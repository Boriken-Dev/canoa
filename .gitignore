# Dotfiles at the root are opt-in.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Agent config and personal overrides, at any depth.
.agents
CLAUDE*
# On a case-insensitive filesystem CLAUDE* also matches this asset, which is not agent config.
!app/assets/icons/agents/claude.svg
.claude
*.local.*

# Rust. The workspace builds a binary, canoa, so its lockfile is committed.
/target/

# Node
node_modules/

# Python: a Guatiao source's interpreter writes bytecode beside a provider's modules, whatever the environment says.
__pycache__/

# Flutter
/app/.dart_tool/
/app/build/
/app/.flutter-plugins*

# Runners `flutter create` generates (python app/tool/build.py desktop); never committed
/app/windows/
/app/linux/
/app/macos/
/app/.metadata
/app/.gitignore

# Built extension UI
/bindings/browser/chromium/ui/
/bindings/browser/firefox/ui/

# Docs build
/site/

# Secrets and OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Generated by app/tool/build_noise.py
/app/web/noise/
/app/test/noise/
/app/web_noise/target/
