# Dotfiles at the root are opt-in.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Agent config and personal overrides, at any depth.
.agents
CLAUDE*
.claude
*.local.*

# Rust. The workspace builds a binary, canoa, so its lockfile is committed.
/target/

# Node
node_modules/

# Python: a Guatiao source's interpreter writes bytecode beside a provider's modules, whatever the environment says.
__pycache__/

# Flutter
/app/.dart_tool/
/app/build/
/app/.flutter-plugins*

# Built extension UI
/bindings/browser/chromium/ui/
/bindings/browser/firefox/ui/

# Docs build
/site/

# Secrets and OS files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
