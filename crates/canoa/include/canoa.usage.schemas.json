{
  "ReaderInfo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The id an entry's `usage` names."
      },
      "bucket_prefix": {
        "type": "string",
        "description": "What every bucket id of the reader starts with, so the host replaces this reader's buckets and no other's."
      },
      "settle_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "How long, in milliseconds, a session is open with no turn running before its figures are first read: the agent's own start and first turn go first."
      },
      "retries_ms": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "description": "How long, in milliseconds, each further try waits after a session's first, while the agent shows nothing to read yet.",
        "default": []
      },
      "cache_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "How long, in milliseconds, a reading counts as current: a request younger than this is answered from it, and no agent is started to read more often."
      },
      "private_limit_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "How long, in milliseconds, an agent the host starts only to read may take from start to end."
      },
      "private_retries_ms": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "description": "How long, in milliseconds, each wait between tries is for such an agent to show something to read.",
        "default": []
      },
      "stored": {
        "type": "boolean",
        "description": "Whether it reads the account from what the agent stores (its login), with no process of the agent running. With no session open the host then opens a reading configured with the entry's account settings, asks [`UsageReading::read`] with `root` 0, and starts no agent to read: a failure is the answer.",
        "default": false
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "bucket_prefix",
      "settle_ms",
      "cache_ms",
      "private_limit_ms"
    ]
  },
  "Reading": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "buckets": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Stable per harness and account: `five_hour`, `seven_day`, `seven_day_opus`, `codex:primary`."
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "What a person sees, when the harness has a name apart from the id."
            },
            "models": {
              "type": "object",
              "x-variant-tag": "kind",
              "oneOf": [
                {
                  "description": "Every model of the account.",
                  "properties": {
                    "kind": {
                      "const": "all"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "The harness did not say. A reader counts it as covering every model, so an exhausted bucket of unknown coverage stops the account for each of them.",
                  "properties": {
                    "kind": {
                      "const": "unknown"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "These models only, by the ids or aliases `models()` lists.",
                  "properties": {
                    "kind": {
                      "const": "only"
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The ids."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "models"
                  ]
                },
                {
                  "description": "A coverage a newer writer named; a reader treats it as unknown.",
                  "properties": {
                    "kind": {
                      "const": "other"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                }
              ],
              "description": "The models it covers."
            },
            "unit": {
              "type": "string",
              "examples": [
                "tokens",
                "requests",
                "micro_usd",
                "permille"
              ],
              "x-enum-labels": {
                "tokens": "Tokens.",
                "requests": "Requests.",
                "micro_usd": "Millionths of a US dollar.",
                "permille": "A percentage only, when the provider gives no absolute number: `limit` is 1000 and `used` thousandths, so the arithmetic is the same for every unit."
              },
              "description": "What it counts."
            },
            "used": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18446744073709551615,
              "description": "How much is used, when the harness said."
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18446744073709551615,
              "description": "How much the bucket holds, when the harness said."
            },
            "remaining": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18446744073709551615,
              "description": "How much is left, when the harness said."
            },
            "refill": {
              "type": "object",
              "x-variant-tag": "kind",
              "oneOf": [
                {
                  "description": "All at once when the window ends, such as a five-hour or weekly allowance.",
                  "properties": {
                    "kind": {
                      "const": "fixed_window"
                    },
                    "length": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999999999
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "How long the window is, when the harness says."
                    },
                    "resets_at": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807,
                      "description": "When it ends, in Unix seconds, when the harness says."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "Continuously: `amount` units each `per`, up to `max`.",
                  "properties": {
                    "kind": {
                      "const": "token_bucket"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615,
                      "description": "The units added each `per`."
                    },
                    "per": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999999999
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "The period."
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615,
                      "description": "The most it holds."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "amount",
                    "per",
                    "max"
                  ]
                },
                {
                  "description": "A balance that never refills.",
                  "properties": {
                    "kind": {
                      "const": "none"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "The harness did not say.",
                  "properties": {
                    "kind": {
                      "const": "unknown"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "A refill a newer writer named; a reader treats it as unknown.",
                  "properties": {
                    "kind": {
                      "const": "other"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ]
                }
              ],
              "description": "How it refills."
            },
            "status": {
              "type": "string",
              "examples": [
                "ok",
                "warning",
                "exhausted",
                "unknown"
              ],
              "x-enum-labels": {
                "ok": "Room is left.",
                "warning": "The harness said it is nearly used. Only when the harness said so: a host applies its own thresholds to the bucket's fraction.",
                "exhausted": "Nothing is left until the bucket refills.",
                "unknown": "The harness did not say."
              },
              "description": "What the harness says of it."
            },
            "observed_at": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807,
              "description": "When these figures were read, in Unix seconds."
            },
            "source": {
              "type": "string",
              "examples": [
                "reported",
                "inferred"
              ],
              "x-enum-labels": {
                "reported": "The harness's own structured figure.",
                "inferred": "Read from an error's words, a 429 or a refusal, by the provider or the host. The bucket's `evidence` holds the words, for logs; nothing parses it."
              },
              "description": "Where the figures came from."
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ],
              "description": "The words an inferred bucket was read from, for logs; nothing parses them."
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "models",
            "unit",
            "refill",
            "status",
            "observed_at",
            "source"
          ]
        },
        "description": "Every bucket the agent's account has, each id starting with [`ReaderInfo::bucket_prefix`]; they replace the ones read before.",
        "default": []
      },
      "failure": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "why": {
            "type": "string",
            "description": "What happened, in one line, for a log; never what the agent said."
          },
          "retry": {
            "type": "string",
            "enum": [
              "never",
              "not_yet",
              "no_answer"
            ],
            "x-enum-labels": {
              "never": "No: the reason will not change by waiting.",
              "not_yet": "Yes: the agent shows nothing to read yet (no session has started what serves its figures).",
              "no_answer": "Yes: it showed something and it did not answer in time or could not be reached."
            },
            "description": "Whether to ask again."
          }
        },
        "additionalProperties": false,
        "required": [
          "why",
          "retry"
        ],
        "description": "Why nothing was read; absent when `buckets` is the reading."
      },
      "account": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "What names the account to a person: an email address, else a name."
          },
          "plan": {
            "type": [
              "string",
              "null"
            ],
            "description": "The plan the account is on, as the agent words it."
          }
        },
        "additionalProperties": false,
        "description": "Who the account is, when the agent says."
      }
    },
    "additionalProperties": false
  },
  "Failure": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "why": {
        "type": "string",
        "description": "What happened, in one line, for a log; never what the agent said."
      },
      "retry": {
        "type": "string",
        "enum": [
          "never",
          "not_yet",
          "no_answer"
        ],
        "x-enum-labels": {
          "never": "No: the reason will not change by waiting.",
          "not_yet": "Yes: the agent shows nothing to read yet (no session has started what serves its figures).",
          "no_answer": "Yes: it showed something and it did not answer in time or could not be reached."
        },
        "description": "Whether to ask again."
      }
    },
    "additionalProperties": false,
    "required": [
      "why",
      "retry"
    ]
  },
  "Retry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "enum": [
      "never",
      "not_yet",
      "no_answer"
    ],
    "x-enum-labels": {
      "never": "No: the reason will not change by waiting.",
      "not_yet": "Yes: the agent shows nothing to read yet (no session has started what serves its figures).",
      "no_answer": "Yes: it showed something and it did not answer in time or could not be reached."
    },
    "properties": {}
  }
}
