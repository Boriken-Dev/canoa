{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boriken.dev/canoa/schemas/canoa.models-1.json",
  "title": "canoa.models/1",
  "description": "A catalog of the models, voices or other file sets a Store type lists. A source reads its upstream (a repository's file tree, a publisher's list) and answers with this.",
  "type": "object",
  "required": ["format", "items"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "canoa.models/1" },
    "revision": {
      "type": "string",
      "description": "What the source read it at: a commit, a version."
    },
    "items": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "files"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Unique in the catalog." },
          "label": { "type": "string" },
          "by": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "license": { "type": "string" },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/file" }
          },
          "engines": {
            "type": "array",
            "description": "The ways the item can be run, each shown as a pill on its tile, installed once every file it reads is in the item's folder.",
            "items": { "$ref": "#/$defs/engine" }
          }
        }
      }
    }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique among the item's engines." },
        "label": { "type": "string", "description": "What the pill says." },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The files it reads, as relative paths in the folder the item's files are kept in; one that no download of the item supplies is written by `make`."
        },
        "make": { "type": "string", "description": "The action the type's provider is asked for, after the download, to write the files no download supplies." },
        "variants": {
          "type": "array",
          "description": "The forms `make` can write, picked in the install dialog; the first is the default. Needs `make`.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "file": { "type": "string", "description": "A relative path of plain names, `/` between them (a model of several files keeps them in a folder of its own); the last part of the URL when absent." },
        "bytes": { "type": "integer", "minimum": 0 },
        "derived": {
          "type": "boolean",
          "description": "The digest was computed from content at a URL that names a full commit, not given by the publisher."
        },
        "check": {
          "oneOf": [
            {
              "type": "object",
              "required": ["sha256"],
              "additionalProperties": false,
              "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
            },
            {
              "type": "object",
              "required": ["sha512"],
              "additionalProperties": false,
              "properties": { "sha512": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" } }
            },
            {
              "type": "object",
              "required": ["md5"],
              "additionalProperties": false,
              "properties": { "md5": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" } }
            },
            {
              "type": "object",
              "required": ["git_blob"],
              "additionalProperties": false,
              "properties": {
                "git_blob": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{40}$",
                  "description": "A git SHA-1 blob id; accepted only when the URL names a full 40-digit commit."
                }
              }
            },
            {
              "type": "object",
              "required": ["unverified"],
              "additionalProperties": false,
              "properties": { "unverified": { "type": "string", "description": "Why the publisher gives no checksum." } }
            }
          ]
        }
      }
    }
  }
}
