      },
      "model": {
        "type": "string",
        "description": "The row's id."
      },
      "values": {
        "type": "string",
        "description": "A JSON object keyed by the schema's members, already checked against it; a member left empty is absent, and no member at all takes the row's settings away."
      }
    },
    "additionalProperties": false,
    "required": [
      "model",
      "values"
    ]
  },
