    "required": [
      "values"
    ]
  },
  "ServiceQuery": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "home": {
        "type": [
          "string",
          "null"
        ],
        "description": "The person's home folder."
      },
      "program": {
        "type": [
          "string",
          "null"
        ],
        "description": "The absolute path of the host's own copy of the type's program, for a `command` service, when the host has one."
      },
      "models": {
        "type": "boolean",
        "description": "Whether to list the models that can transcribe, which may take a request to the service.",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "ServiceReport": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "address": {
        "type": [
          "string",
          "null"
        ],
        "description": "The address, with no path, when the service is up."
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The name a recording's request names."
            },
            "label": {
              "type": "string",
              "description": "What the offer calls it."
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "label"
          ]
        },
        "description": "The models that can transcribe, when asked for and the service is up.",
        "default": []
      },
      "unavailable": {
        "type": [
          "string",
          "null"
        ],
        "description": "Why the service cannot take a recording now, in the offer's words; none when it can."
      },
      "command": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "program": {
            "type": "string",
            "description": "The absolute path of the program."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Its arguments. `{language_code|auto}` is the language the person said (or `auto`) and `{vocabulary}` their own words.",
            "default": []
          },
          "input": {
            "type": "string",
            "description": "How the audio reaches it: `wav` or `pcm`."
          },
          "model": {
            "type": "string",
            "description": "The model this copy runs, as one of [`ServiceReport::models`] names it."
          }
        },
        "additionalProperties": false,
        "required": [
          "program",
          "input",
          "model"
        ],
        "description": "How to run the copy of a `command` service, when there is a copy that can be."
      }
    },
    "additionalProperties": false
  },
  "ServedModel": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
