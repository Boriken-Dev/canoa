        "type": [
          "string",
          "null"
        ],
        "description": "The program, as [`ModelQuery::program`]."
      },
      "home": {
        "type": [
          "string",
          "null"
        ],
        "description": "The person's home folder."
      },
      "model": {
        "type": "string",
        "description": "The row's id."
      },
      "action": {
        "type": "string",
        "description": "One of the actions a [`RowAction`] named."
      }
    },
    "additionalProperties": false,
    "required": [
      "model",
      "action"
    ]
  },
  "ModelActed": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
