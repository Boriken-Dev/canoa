{
  "ModelStoreInfo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "The name of the page that lists the models, in the plural, as the Store's index says it."
      },
      "catalog": {
        "type": "string",
        "description": "Where the rows come from, in the words the page's filter uses."
      },
      "publisher": {
        "type": "string",
        "description": "Who the rows are by, when a row names no one."
      },
      "missing": {
        "type": "string",
        "description": "What the page says in place of rows when [`ModelList::unavailable`] is set and says nothing of its own."
      },
      "settings": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "table": {
            "type": "string",
            "description": "The table of canoa.cfg that is the library's own: 1 to 32 lower-case letters, digits and `_`, and none of [`RESERVED_TABLES`]."
          },
          "help": {
            "type": [
              "string",
              "null"
            ],
            "description": "A line saying what the settings are for."
          },
          "schema": {
            "description": "The members the settings hold."
          },
          "form": {
            "description": "How the schema is shown; none shows the form it implies."
          }
        },
        "additionalProperties": false,
        "required": [
          "table",
          "schema"
        ],
        "description": "The settings a row keeps, when it keeps any."
      },
      "speech": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "The name of the offer."
          },
          "summary": {
            "type": "string",
            "description": "What it is, in a sentence."
          },
          "license": {
            "type": [
              "string",
              "null"
            ],
            "description": "The licence of what transcribes, when it has one to say."
          },
          "location": {
            "type": "string",
            "description": "Where the audio goes, in a sentence or two, as the offer says it before the person sets it up."
          },
          "route": {
            "type": "string",
            "description": "The path below the service's address that takes a recording, starting with `/`; empty for a `command`.",
            "default": ""
          },
          "local_file": {
            "type": "boolean",
            "description": "Whether the recording is written to a file on this computer and its name posted, in place of the audio being sent.",
            "default": false
          },
          "command": {
            "type": "boolean",
            "description": "Whether it is a program run once for each recording, with the audio on its standard input, in place of a server: the offer is then installed through the type's first `program_store`, with a model chosen as that store's channel, and [`ServiceReport::command`] says how the installed copy is run.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "location"
        ],
        "description": "How the person's speech-to-text calls the service that runs these models, when it can."
      }
    },
    "additionalProperties": false,
    "required": [
      "title",
      "catalog",
      "publisher",
      "missing"
    ]
  },
  "ModelSettings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "table": {
        "type": "string",
        "description": "The table of canoa.cfg that is the library's own: 1 to 32 lower-case letters, digits and `_`, and none of [`RESERVED_TABLES`]."
