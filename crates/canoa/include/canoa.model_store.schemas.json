    "type": "object",
    "properties": {
      "values": {
        "type": "string",
        "description": "A JSON object of what the host writes: the values as given, or settled (a number held to the model's own limit). `{}` takes the row's settings away."
      },
      "note": {
        "type": [
          "string",
          "null"
        ],
        "description": "A line saying what was changed (a value lowered to what the model allows)."
      }
    },
