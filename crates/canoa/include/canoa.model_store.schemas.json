    },
    "additionalProperties": false,
    "required": [
      "table",
      "schema"
    ]
  },
  "SpeechService": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "The name of the offer."
      },
      "summary": {
        "type": "string",
        "description": "What it is, in a sentence."
      },
      "license": {
        "type": [
          "string",
          "null"
        ],
        "description": "The licence of what transcribes, when it has one to say."
      },
      "location": {
        "type": "string",
        "description": "Where the audio goes, in a sentence or two, as the offer says it before the person sets it up."
      },
      "route": {
        "type": "string",
        "description": "The path below the service's address that takes a recording, starting with `/`; empty for a `command`.",
        "default": ""
      },
      "local_file": {
        "type": "boolean",
        "description": "Whether the recording is written to a file on this computer and its name posted, in place of the audio being sent.",
        "default": false
      },
      "command": {
        "type": "boolean",
        "description": "Whether it is a program run once for each recording, with the audio on its standard input, in place of a server: the offer is then installed through the type's first `program_store`, with a model chosen as that store's channel, and [`ServiceReport::command`] says how the installed copy is run.",
        "default": false
      }
    },
    "additionalProperties": false,
    "required": [
      "title",
      "summary",
      "location"
    ]
  },
  "ModelQuery": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "program": {
        "type": [
          "string",
          "null"
        ],
        "description": "The absolute path of the program the type's `program_store` installed or found (the host's own copy first), or none when it found no copy."
      },
      "home": {
        "type": [
          "string",
          "null"
        ],
        "description": "The person's home folder, where programs keep their own files."
      }
    },
    "additionalProperties": false
  },
  "ModelList": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The name the other methods take, and the row's name."
            },
            "by": {
              "type": [
                "string",
                "null"
              ],
              "description": "Who it is by, when not the store's publisher; the row's second line."
            },
            "summary": {
              "type": "string",
              "description": "Where it stands and what it is, in a line."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "What the page's tag filter lists it under.",
              "default": []
            },
            "on": {
              "type": "boolean",
              "description": "Whether the tile is marked: the model is in use.",
              "default": false
            },
            "state": {
              "type": [
                "string",
                "null"
              ],
              "description": "Its state in a word, when it has one worth a badge."
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "What it is."
                  },
                  "value": {
                    "type": "string",
                    "description": "What it holds."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ]
              },
              "description": "What its page's overview states.",
              "default": []
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The title of the confirmation."
                  },
                  "confirm": {
                    "type": "string",
                    "description": "What it takes, in the words the confirmation shows."
                  },
                  "label": {
                    "type": "string",
                    "description": "What the confirming button says."
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The actions [`ModelStore::act`] is asked for, in order; the next is asked only when the one before is done."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "title",
                  "confirm",
                  "label",
                  "steps"
                ]
              },
              "description": "What it can do; `+` does the first.",
              "default": []
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Its heading."
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "What it is."
                        },
                        "value": {
                          "type": "string",
                          "description": "What it holds."
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "value"
                      ]
                    },
                    "description": "What it states, one label and value each.",
                    "default": []
                  },
                  "paragraphs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "What it says, a paragraph each.",
                    "default": []
                  },
                  "settings": {
                    "type": "boolean",
                    "description": "Whether the form of [`ModelSettings`] is drawn in it, after the paragraphs.",
                    "default": false
                  }
                },
                "additionalProperties": false,
                "required": [
                  "title"
                ]
              },
              "description": "What its page shows, in order.",
              "default": []
            },
            "speech": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "description": "What the page says of using the model for speech, a paragraph."
                },
                "caution": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "What the page warns of now (the model is not ready), when it does."
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "description": "Present when it may be used as the person's speech-to-text."
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "summary"
          ]
        },
        "description": "The rows, in the order the page shows them.",
        "default": []
      },
      "unavailable": {
        "type": [
          "string",
          "null"
        ],
        "description": "Why there are none to list now, in the page's words (the program is not installed); none when there are rows or the list is empty because the program lists no model."
      }
    },
    "additionalProperties": false
  },
