{
  "ByteRange": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "start": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "The first byte."
      },
      "length": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615,
        "description": "How many bytes; to the end when absent."
      }
    },
    "additionalProperties": false,
    "required": [
      "start"
    ]
  },
  "ContentInfo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The id `[host.disabled]` names it by: a word of lower-case letters, digits and `_`, 1 to 32."
      },
      "title": {
        "type": "string",
        "description": "Its name for people."
      },
      "help": {
        "type": [
          "string",
          "null"
        ],
        "description": "A line saying what it reads."
      },
      "schemes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The scheme: lower-case letters, digits, `+`, `.` and `-`, 2 to 32 characters, the first a letter."
            },
            "title": {
              "type": "string",
              "description": "What it reaches, for people."
            },
            "grammar": {
              "type": "string",
              "description": "One line of grammar, such as `hf://[datasets/]owner/name[/path][?ref=REV]`."
            },
            "lists": {
              "type": "boolean",
              "description": "Whether `list` works.",
              "default": false
            },
            "resolves": {
              "type": "boolean",
              "description": "Whether `resolve` works.",
              "default": false
            },
            "ranges": {
              "type": "boolean",
              "description": "Whether `open` honours a range.",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "title",
            "grammar"
          ]
        },
        "description": "The schemes it serves. Two providers never serve one scheme: the second to load is refused.",
        "default": []
      },
      "endpoints": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The `https` places the deliveries it hands out (`locator`) may point to, redirects included, each an origin or a prefix with a path.",
        "default": []
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "title"
    ]
  },
  "Delivery": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "inline": {
        "type": [
          "bytes",
          "null"
        ],
        "description": "The bytes themselves, at most the request's `max_inline`."
      },
      "locator": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The address."
          },
          "ranges": {
            "type": "boolean",
            "description": "Whether it answers a `Range` request.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "description": "An address the host fetches the bytes from."
      },
      "not_modified": {
        "type": "boolean",
        "description": "The request's `if_none_match` matched: nothing changed.",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "Digest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "algorithm": {
        "type": "string",
        "description": "The algorithm as the publisher names it: `sha256`, `sha512`, `git_blob`, and weaker ones recorded as given. Never another algorithm than the publisher's, and never a hash-shaped value that is not a digest of the content."
      },
      "value": {
        "type": "string",
        "description": "The digest, as the publisher writes it."
      },
      "provenance": {
        "type": "string",
        "enum": [
          "published",
          "derived"
        ],
        "x-enum-labels": {
          "published": "The publisher states it.",
          "derived": "The provider worked it out from the content."
        },
        "description": "Whether the publisher states it or the provider derived it."
      }
    },
    "additionalProperties": false,
    "required": [
      "algorithm",
      "value",
      "provenance"
    ]
  },
  "GenerateRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "description": "The id of the Store type the catalog is of."
      },
      "label": {
        "type": "string",
        "description": "The label the person gave the catalog."
      },
      "source": {
        "type": [
          "string",
          "null"
        ],
        "description": "The entry's `source` URI, when it has one."
      },
      "fields": {
        "type": "string",
        "description": "What the form's fields hold, as a JSON object keyed by member name; a field left empty is absent."
      },
      "pin": {
        "type": [
          "string",
          "null"
        ],
        "description": "The entry's `pin`: a revision the generator understands, or `sha256:<hex>` of the catalog's text, which the host checks."
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The fingerprints the entry demands a signature from, in place of the generator's own.",
        "default": []
      }
    },
    "additionalProperties": false,
    "required": [
      "kind",
      "label",
      "fields"
    ]
  },
  "GeneratorInfo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The id canoa.cfg records as `generator`: a word of lower-case letters, digits and `_`, 1 to 32."
      },
      "title": {
        "type": "string",
        "description": "Its name for people."
      },
      "help": {
        "type": [
          "string",
          "null"
        ],
        "description": "A line saying what it makes a catalog of."
      },
      "types": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The Store types it serves, by id; none means every type.",
        "default": []
      },
      "source": {
        "type": "string",
        "enum": [
          "required",
          "optional",
          "absent"
        ],
        "x-enum-labels": {
          "required": "The entry's `source` is needed.",
          "optional": "The entry's `source` is used when given.",
          "absent": "The generator reads no source (a program the person named)."
        },
        "description": "Whether it reads the entry's `source`.",
        "default": "required"
      },
      "grammar": {
        "type": [
          "string",
          "null"
        ],
        "description": "What a `source` must look like for it, in a line of grammar."
      },
      "schema": {
        "description": "The values its form asks for, as a guatiao schema of an object. No member is called one of [`HOST_KEYS`]."
      },
      "form": {
        "description": "How the schema is shown, a guatiao-intake form document."
      },
      "endpoints": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The `https` places it may read besides the entry's `source`: an origin or a prefix with a path.",
        "default": []
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The fingerprints of the publisher keys it verifies what it reads with, in the publisher's own notation. An entry's `keys` replace them.",
        "default": []
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "title"
    ]
  },
  "ListEntry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Its path relative to the listed URI, `/`-separated. An entry whose name is not one path component (`..`, `a/b`, empty, NUL) is left out by the host."
      },
      "kind": {
        "type": "string",
        "enum": [
          "file",
          "dir"
