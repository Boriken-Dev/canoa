          "modified_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807,
            "description": "When it last changed, in milliseconds since the epoch, when known."
          },
          "etag": {
            "type": [
              "string",
              "null"
            ],
            "description": "An opaque version tag a later `open` may send as `if_none_match`."
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its media type, when known."
          },
          "digests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "description": "The algorithm as the publisher names it: `sha256`, `sha512`, `git_blob`, and weaker ones recorded as given. Never another algorithm than the publisher's, and never a hash-shaped value that is not a digest of the content."
                },
                "value": {
                  "type": "string",
                  "description": "The digest, as the publisher writes it."
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "published",
                    "derived"
                  ],
                  "x-enum-labels": {
                    "published": "The publisher states it.",
                    "derived": "The provider worked it out from the content."
                  },
                  "description": "Whether the publisher states it or the provider derived it."
                }
              },
              "additionalProperties": false,
              "required": [
                "algorithm",
                "value",
                "provenance"
              ]
            },
            "description": "The digests the provider knows without reading the file.",
            "default": []
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "The revision of the place this answers for (a commit, a version), when the scheme has revisions."
          },
          "immutable": {
            "type": "boolean",
            "description": "Whether the content at this URI can never change: a commit id, a digest-keyed name, a `data:` URI.",
            "default": false
          },
          "ranges": {
            "type": "boolean",
            "description": "Whether `open` honours a range.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "description": "What the listing gave of it, `size` and `modified_ms` absent when it did not; the host asks `stat` for what it needs."
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "kind"
    ]
  },
  "ListRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "target": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "The URI, as the scheme's grammar writes it."
          },
          "person": {
            "type": "boolean",
            "description": "Whether the person wrote the URI (canoa.cfg, the application), as opposed to a catalog document naming it. A provider that runs something as the person (git with their credentials) does it only for a URI the person wrote.",
            "default": false
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615,
            "description": "How long the provider may take, in milliseconds; 0 leaves it to the provider.",
            "default": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "uri"
        ],
        "description": "The folder."
      },
      "cursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "The cursor of the page wanted, from a listing's `next`; the first page when absent."
      },
      "max_entries": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "description": "The most entries one page holds."
      },
      "recursive": {
        "type": "boolean",
        "description": "Whether to list everything below, not only the folder's own entries.",
        "default": false
      }
    },
    "additionalProperties": false,
    "required": [
      "target",
      "max_entries"
    ]
  },
