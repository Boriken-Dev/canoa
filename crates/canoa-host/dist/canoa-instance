#!/bin/sh
# The only thing the portal's service account may ask root for: `canoa-instance start|stop [--no-ask-password] canoa@NAME.service`.
#
# Install as /usr/libexec/canoa-instance (root, mode 0755) and allow it in sudoers with no password and no argument pattern:
#
#     canoa ALL=(root) NOPASSWD: /usr/libexec/canoa-instance
#
# and set the portal's `elevate = ["sudo", "-n"]` and `systemctl = "/usr/libexec/canoa-instance"`. The checks are here, in root's
# own code, so a sudoers wildcard is never needed. NAME must match
#
# [A-Za-z_][A-Za-z0-9._-]{0,31}
#
# (the pattern the portal and the polkit rule use: a name that begins with a digit is a user id to systemd), must be an account
# in one of ALLOWED_GROUPS (the portal's `groups`; with none named nothing is started), and must have a user id of MIN_UID or
# more that is not in the machine's system and dynamic-user ranges: root, service accounts and `nobody` never get a host. The
# host refuses the same ones itself, which is the check that decides.
set -eu

PATH=/usr/bin:/bin
LC_ALL=C
export PATH LC_ALL

MIN_UID=1000
PREFIX=canoa
ALLOWED_GROUPS=canoa-users

[ $# -ge 2 ] || exit 2
verb=$1
shift
if [ "${1:-}" = --no-ask-password ]; then shift; fi
[ $# -eq 1 ] || exit 2
unit=$1
case $verb in start | stop) ;; *) exit 2 ;; esac
case $unit in "$PREFIX"@*.service) ;; *) exit 2 ;; esac
name=${unit#"$PREFIX"@}
name=${name%.service}
case $name in
''|[!A-Za-z_]*|*[!A-Za-z0-9._-]*) exit 2 ;;
esac
[ "${#name}" -le 32 ] || exit 2
uid=$(/usr/bin/id -u -- "$name" 2>/dev/null) || exit 2
[ "$uid" -ge "$MIN_UID" ] || exit 2
# systemd's dynamic users and `nobody`, and the top of the range; a directory's people have ids below and above these.
if [ "$uid" -ge 61184 ] && [ "$uid" -le 65535 ]; then exit 2; fi
[ "$uid" -lt 4294967295 ] || exit 2
[ -n "$ALLOWED_GROUPS" ] || exit 2
member=no
have=$(/usr/bin/id -Gn -- "$name" 2>/dev/null) || exit 2
for want in $ALLOWED_GROUPS; do
    for got in $have; do
        [ "$got" = "$want" ] && member=yes
    done
done
[ "$member" = yes ] || exit 2
exec /usr/bin/systemctl "$verb" --no-ask-password "$unit"
