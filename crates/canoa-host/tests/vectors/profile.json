{
  "about": "Profile documents, their merge and the effective view, read by canoa-host (tests/profile.rs) and the app (app/test/profile_vectors_test.dart). Each layer is a TOML document; `effective` is the view both produce, or `error` the first refusal: its layer's index, a code, and for every code but parse the key it names.",
  "merges": [
    {
      "name": "all six layers: a later layer wins per key, lists merge by name, a layer removes an entry",
      "layers": [
        {
          "kind": "built-in",
          "toml": "mode = \"default\"\n[env.CANOA]\nvalue = \"1\"\n"
        },
        {
          "kind": "overlay",
          "name": "team",
          "toml": "model = \"team-model\"\neffort = \"medium\"\ncontext = { file = \"CONTEXT.md\" }\n[env.GITHUB_TOKEN]\nfrom_env = \"GITHUB_TOKEN\"\n[skills.review]\npath = \"skills/review\"\n[mcp.docs]\ntype = \"http\"\nurl = \"https://docs.example/mcp\"\n"
        },
        {
          "kind": "user",
          "toml": "share_env = [\"GITHUB_TOKEN\"]\neffort = \"high\"\n[env.RUST_LOG]\nvalue = \"info\"\n[skills.notes]\npath = \"/home/me/skills/notes\"\n"
        },
        {
          "kind": "project",
          "toml": "mode = \"plan\"\n[env.RUST_LOG]\nvalue = \"debug\"\n[mcp.docs]\nremove = true\n[mcp.files]\ntype = \"stdio\"\ncommand = \"npx\"\nargs = [\"-y\", \"server-files\", \".\"]\n[mcp.files.env.FILES_ROOT]\nvalue = \".\"\n"
        },
        {
          "kind": "agent",
          "name": "Claude",
          "toml": "model = \"claude-x\"\nunset = [\"context\"]\n[skills.review]\nremove = true\n"
        },
        {
          "kind": "session",
          "toml": "effort = \"low\"\n[env.EXTRA]\nfrom_file = \"/run/secrets/extra\"\n"
        }
      ],
      "effective": {
        "model": {
          "value": "claude-x",
          "layer": "agent:Claude"
        },
        "effort": {
          "value": "low",
          "layer": "session"
        },
        "mode": {
          "value": "plan",
          "layer": "project"
        },
        "env": [
          {
            "name": "CANOA",
            "value": {
              "value": "1"
            },
            "layer": "built-in"
          },
          {
            "name": "GITHUB_TOKEN",
            "value": {
              "from_env": "GITHUB_TOKEN"
            },
            "layer": "overlay:team"
          },
          {
            "name": "RUST_LOG",
            "value": {
              "value": "debug"
            },
            "layer": "project"
          },
          {
            "name": "EXTRA",
            "value": {
              "from_file": "/run/secrets/extra"
            },
            "layer": "session"
          }
        ],
        "skills": [
          {
            "name": "notes",
            "value": {
              "path": "/home/me/skills/notes"
            },
            "layer": "user"
          }
        ],
        "mcp": [
          {
            "name": "files",
            "value": {
              "type": "stdio",
              "command": "npx",
              "args": [
                "-y",
                "server-files",
                "."
              ],
              "env": {
                "FILES_ROOT": {
                  "value": "."
                }
              }
            },
            "layer": "project"
          }
        ],
        "removed": [
          {
            "key": "mcp.docs",
            "layer": "project",
            "was": "overlay:team"
          },
          {
            "key": "context",
            "layer": "agent:Claude",
            "was": "overlay:team"
          },
          {
            "key": "skills.review",
            "layer": "agent:Claude",
            "was": "overlay:team"
          }
        ],
        "share_env": [
          {
            "name": "GITHUB_TOKEN",
            "layer": "user"
          }
        ],
        "refused": []
      }
    },
    {
      "name": "an entry a later layer names again is replaced whole and keeps its place",
      "layers": [
        {
          "kind": "overlay",
          "name": "a",
          "toml": "[env.A]\nvalue = \"1\"\n[env.B]\nvalue = \"2\"\n"
        },
        {
          "kind": "user",
          "toml": "[env.A]\nfrom_env = \"A_SECRET\"\n"
        }
      ],
      "effective": {
        "env": [
          {
            "name": "A",
            "value": {
              "from_env": "A_SECRET"
            },
            "layer": "user"
          },
          {
            "name": "B",
            "value": {
              "value": "2"
            },
            "layer": "overlay:a"
          }
        ],
        "skills": [],
        "mcp": [],
        "removed": [],
        "share_env": [],
        "refused": []
      }
    },
    {
      "name": "an entry removed and named again by a later layer comes last",
      "layers": [
        {
          "kind": "built-in",
          "toml": "[skills.a]\npath = \"a\"\n[skills.b]\npath = \"b\"\n"
        },
        {
          "kind": "user",
          "toml": "[skills.a]\nremove = true\n"
        },
        {
          "kind": "agent",
          "name": "Pi",
          "toml": "[skills.a]\npath = \"again\"\n"
        }
      ],
      "effective": {
        "env": [],
        "skills": [
          {
            "name": "b",
            "value": {
              "path": "b"
            },
            "layer": "built-in"
          },
          {
            "name": "a",
            "value": {
              "path": "again"
            },
            "layer": "agent:Pi"
          }
        ],
        "mcp": [],
        "removed": [
          {
            "key": "skills.a",
            "layer": "user",
            "was": "built-in"
          }
        ],
        "share_env": [],
        "refused": []
      }
    },
    {
      "name": "removing what no lower layer has removes nothing",
      "layers": [
        {
          "kind": "user",
          "toml": "unset = [\"model\", \"mode\"]\n[env.NONE]\nremove = true\n[mcp.none]\nremove = true\n"
        }
      ],
      "effective": {
        "env": [],
        "skills": [],
        "mcp": [],
        "removed": [],
        "share_env": [],
        "refused": []
      }
    },
    {
      "name": "an MCP server is replaced whole, never field by field",
      "layers": [
        {
          "kind": "overlay",
          "name": "base",
          "toml": "[mcp.search]\ntype = \"stdio\"\ncommand = \"search-mcp\"\n[mcp.search.env.KEY]\nfrom_env = \"SEARCH_KEY\"\n"
        },
        {
          "kind": "user",
          "toml": "[mcp.search]\ntype = \"sse\"\nurl = \"http://127.0.0.1:9000/sse\"\n[mcp.search.headers.Authorization]\nfrom_file = \"search.token\"\n"
        }
      ],
      "effective": {
        "env": [],
        "skills": [],
        "mcp": [
          {
            "name": "search",
            "value": {
              "type": "sse",
              "url": "http://127.0.0.1:9000/sse",
              "headers": {
                "Authorization": {
                  "from_file": "search.token"
                }
              }
            },
            "layer": "user"
          }
        ],
        "removed": [],
        "share_env": [],
        "refused": [
          {
            "key": "mcp.search",
            "layer": "overlay:base",
            "reads": "SEARCH_KEY"
          }
        ]
      }
    },
    {
      "name": "context as text, and a later layer's context of the other form",
      "layers": [
        {
          "kind": "user",
          "toml": "context = { text = \"Answer in Spanish.\\nKeep it short.\" }\n"
        },
        {
          "kind": "session",
          "toml": "context = { file = \"/tmp/brief.md\" }\n"
        }
      ],
      "effective": {
        "context": {
          "value": {
            "file": "/tmp/brief.md"
          },
          "layer": "session"
        },
        "env": [],
        "skills": [],
        "mcp": [],
        "removed": [],
        "share_env": [],
        "refused": []
      }
    },
    {
      "name": "unset and set again in a later layer",
      "layers": [
        {
          "kind": "built-in",
          "toml": "model = \"a\"\n"
        },
        {
          "kind": "user",
          "toml": "unset = [\"model\"]\n"
        },
        {
          "kind": "session",
          "toml": "model = \"b\"\n"
        }
      ],
      "effective": {
        "model": {
          "value": "b",
          "layer": "session"
        },
        "env": [],
        "skills": [],
        "mcp": [],
        "removed": [
          {
            "key": "model",
            "layer": "user",
            "was": "built-in"
          }
        ],
        "share_env": [],
        "refused": []
      }
    },
    {
      "name": "an empty document is an empty layer",
