{
  "about": "Profile documents, their merge and the effective view, read by canoa-host (tests/profile.rs) and the app (app/test/profile_vectors_test.dart). Each layer is a TOML document; `effective` is the view both produce, or `error` the first refusal: its layer's index, a code, and for every code but parse the key it names.",
  "merges": [
    {
      "name": "all six layers: a later layer wins per key, lists merge by name, a layer removes an entry",
      "layers": [
        { "kind": "built-in", "toml": "mode = \"default\"\n[env.CANOA]\nvalue = \"1\"\n" },
        { "kind": "overlay", "name": "team", "toml": "model = \"team-model\"\neffort = \"medium\"\ncontext = { file = \"CONTEXT.md\" }\n[env.GITHUB_TOKEN]\nfrom_env = \"GITHUB_TOKEN\"\n[skills.review]\npath = \"skills/review\"\n[mcp.docs]\ntype = \"http\"\nurl = \"https://docs.example/mcp\"\n" },
        { "kind": "user", "toml": "effort = \"high\"\n[env.RUST_LOG]\nvalue = \"info\"\n[skills.notes]\npath = \"/home/me/skills/notes\"\n" },
        { "kind": "project", "toml": "mode = \"plan\"\n[env.RUST_LOG]\nvalue = \"debug\"\n[mcp.docs]\nremove = true\n[mcp.files]\ntype = \"stdio\"\ncommand = \"npx\"\nargs = [\"-y\", \"server-files\", \".\"]\n[mcp.files.env.FILES_ROOT]\nvalue = \".\"\n" },
        { "kind": "agent", "name": "Claude", "toml": "model = \"claude-x\"\nunset = [\"context\"]\n[skills.review]\nremove = true\n" },
        { "kind": "session", "toml": "effort = \"low\"\n[env.EXTRA]\nfrom_file = \"/run/secrets/extra\"\n" }
      ],
      "effective": {
        "model": { "value": "claude-x", "layer": "agent:Claude" },
        "effort": { "value": "low", "layer": "session" },
        "mode": { "value": "plan", "layer": "project" },
        "env": [
          { "name": "CANOA", "value": { "value": "1" }, "layer": "built-in" },
          { "name": "GITHUB_TOKEN", "value": { "from_env": "GITHUB_TOKEN" }, "layer": "overlay:team" },
          { "name": "RUST_LOG", "value": { "value": "debug" }, "layer": "project" },
          { "name": "EXTRA", "value": { "from_file": "/run/secrets/extra" }, "layer": "session" }
        ],
        "skills": [
          { "name": "notes", "value": { "path": "/home/me/skills/notes" }, "layer": "user" }
        ],
        "mcp": [
          { "name": "files", "value": { "type": "stdio", "command": "npx", "args": ["-y", "server-files", "."], "env": { "FILES_ROOT": { "value": "." } } }, "layer": "project" }
        ],
        "removed": [
          { "key": "mcp.docs", "layer": "project", "was": "overlay:team" },
          { "key": "context", "layer": "agent:Claude", "was": "overlay:team" },
          { "key": "skills.review", "layer": "agent:Claude", "was": "overlay:team" }
        ]
      }
    },
    {
      "name": "an entry a later layer names again is replaced whole and keeps its place",
      "layers": [
        { "kind": "overlay", "name": "a", "toml": "[env.A]\nvalue = \"1\"\n[env.B]\nvalue = \"2\"\n" },
        { "kind": "user", "toml": "[env.A]\nfrom_env = \"A_SECRET\"\n" }
      ],
      "effective": {
        "env": [
          { "name": "A", "value": { "from_env": "A_SECRET" }, "layer": "user" },
          { "name": "B", "value": { "value": "2" }, "layer": "overlay:a" }
        ],
        "skills": [],
        "mcp": [],
        "removed": []
      }
    },
    {
      "name": "an entry removed and named again by a later layer comes last",
      "layers": [
        { "kind": "built-in", "toml": "[skills.a]\npath = \"a\"\n[skills.b]\npath = \"b\"\n" },
        { "kind": "user", "toml": "[skills.a]\nremove = true\n" },
        { "kind": "agent", "name": "Pi", "toml": "[skills.a]\npath = \"again\"\n" }
      ],
      "effective": {
        "env": [],
        "skills": [
          { "name": "b", "value": { "path": "b" }, "layer": "built-in" },
          { "name": "a", "value": { "path": "again" }, "layer": "agent:Pi" }
        ],
        "mcp": [],
        "removed": [ { "key": "skills.a", "layer": "user", "was": "built-in" } ]
      }
    },
    {
      "name": "removing what no lower layer has removes nothing",
      "layers": [
        { "kind": "user", "toml": "unset = [\"model\", \"mode\"]\n[env.NONE]\nremove = true\n[mcp.none]\nremove = true\n" }
      ],
      "effective": { "env": [], "skills": [], "mcp": [], "removed": [] }
    },
    {
      "name": "an MCP server is replaced whole, never field by field",
      "layers": [
        { "kind": "overlay", "name": "base", "toml": "[mcp.search]\ntype = \"stdio\"\ncommand = \"search-mcp\"\n[mcp.search.env.KEY]\nfrom_env = \"SEARCH_KEY\"\n" },
        { "kind": "user", "toml": "[mcp.search]\ntype = \"sse\"\nurl = \"http://127.0.0.1:9000/sse\"\n[mcp.search.headers.Authorization]\nfrom_file = \"search.token\"\n" }
      ],
      "effective": {
        "env": [],
        "skills": [],
        "mcp": [
          { "name": "search", "value": { "type": "sse", "url": "http://127.0.0.1:9000/sse", "headers": { "Authorization": { "from_file": "search.token" } } }, "layer": "user" }
        ],
        "removed": []
      }
    },
    {
      "name": "context as text, and a later layer's context of the other form",
      "layers": [
        { "kind": "user", "toml": "context = { text = \"Answer in Spanish.\\nKeep it short.\" }\n" },
        { "kind": "session", "toml": "context = { file = \"/tmp/brief.md\" }\n" }
      ],
      "effective": {
        "context": { "value": { "file": "/tmp/brief.md" }, "layer": "session" },
        "env": [], "skills": [], "mcp": [], "removed": []
      }
    },
    {
      "name": "unset and set again in a later layer",
      "layers": [
        { "kind": "built-in", "toml": "model = \"a\"\n" },
        { "kind": "user", "toml": "unset = [\"model\"]\n" },
        { "kind": "session", "toml": "model = \"b\"\n" }
      ],
      "effective": {
        "model": { "value": "b", "layer": "session" },
        "env": [], "skills": [], "mcp": [],
        "removed": [ { "key": "model", "layer": "user", "was": "built-in" } ]
      }
    },
    {
      "name": "an empty document is an empty layer",
      "layers": [ { "kind": "project", "toml": "" } ],
      "effective": { "env": [], "skills": [], "mcp": [], "removed": [] }
    },
    { "name": "not TOML", "layers": [ { "kind": "user", "toml": "model = \n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "a key no profile has", "layers": [ { "kind": "user", "toml": "colour = \"red\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "a key twice", "layers": [ { "kind": "user", "toml": "model = \"a\"\nmodel = \"b\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "a model that is not text", "layers": [ { "kind": "user", "toml": "model = 3\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "a key no env entry has", "layers": [ { "kind": "user", "toml": "[env.A]\nsecret = \"x\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "a key no MCP server has", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\ncommand = \"x\"\ncwd = \"/\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "args that are not a list of text", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\ncommand = \"x\"\nargs = [1]\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "remove that is not a boolean", "layers": [ { "kind": "user", "toml": "[skills.a]\nremove = \"yes\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "unset that is not a list", "layers": [ { "kind": "user", "toml": "unset = \"model\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "context that is not a table", "layers": [ { "kind": "user", "toml": "context = \"hi\"\n" } ], "error": { "layer": 0, "code": "parse" } },
    { "name": "an env entry of two forms", "layers": [ { "kind": "user", "toml": "[env.A]\nvalue = \"1\"\nfrom_env = \"B\"\n" } ], "error": { "layer": 0, "code": "form", "key": "env.A" } },
    { "name": "an env entry of no form", "layers": [ { "kind": "user", "toml": "[env.A]\n" } ], "error": { "layer": 0, "code": "form", "key": "env.A" } },
    { "name": "remove = false", "layers": [ { "kind": "user", "toml": "[skills.a]\nremove = false\n" } ], "error": { "layer": 0, "code": "form", "key": "skills.a" } },
    { "name": "remove beside a value", "layers": [ { "kind": "user", "toml": "[env.A]\nvalue = \"1\"\nremove = true\n" } ], "error": { "layer": 0, "code": "form", "key": "env.A" } },
    { "name": "an MCP server removed with a type", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"http\"\nremove = true\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "context of both forms", "layers": [ { "kind": "user", "toml": "context = { text = \"a\", file = \"b\" }\n" } ], "error": { "layer": 0, "code": "form", "key": "context" } },
    { "name": "context of no form", "layers": [ { "kind": "user", "toml": "context = {}\n" } ], "error": { "layer": 0, "code": "form", "key": "context" } },
    { "name": "a value set and unset in one layer", "layers": [ { "kind": "user", "toml": "model = \"a\"\nunset = [\"model\"]\n" } ], "error": { "layer": 0, "code": "form", "key": "model" } },
    { "name": "unset naming no value", "layers": [ { "kind": "user", "toml": "unset = [\"env\"]\n" } ], "error": { "layer": 0, "code": "form", "key": "unset" } },
    { "name": "an MCP server of no known type", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"ws\"\nurl = \"https://x\"\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "an MCP server with no type", "layers": [ { "kind": "user", "toml": "[mcp.a]\ncommand = \"x\"\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "a stdio MCP server with no command", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "an HTTP MCP server with a command", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"http\"\nurl = \"https://x\"\ncommand = \"y\"\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "a stdio MCP server with headers", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\ncommand = \"y\"\n[mcp.a.headers.X]\nvalue = \"1\"\n" } ], "error": { "layer": 0, "code": "form", "key": "mcp.a" } },
    { "name": "a skill with no path", "layers": [ { "kind": "user", "toml": "[skills.a]\n" } ], "error": { "layer": 0, "code": "form", "key": "skills.a" } },
    { "name": "an env name that starts with a digit", "layers": [ { "kind": "user", "toml": "[env.1A]\nvalue = \"1\"\n" } ], "error": { "layer": 0, "code": "name", "key": "env" } },
    { "name": "a skill name with a space", "layers": [ { "kind": "user", "toml": "[skills.\"a b\"]\npath = \"x\"\n" } ], "error": { "layer": 0, "code": "name", "key": "skills" } },
    { "name": "an MCP server name over 64", "layers": [ { "kind": "user", "toml": "[mcp.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]\ntype = \"stdio\"\ncommand = \"x\"\n" } ], "error": { "layer": 0, "code": "name", "key": "mcp" } },
    { "name": "a header name with a colon", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"http\"\nurl = \"https://x\"\n[mcp.a.headers.\"X:Y\"]\nvalue = \"1\"\n" } ], "error": { "layer": 0, "code": "name", "key": "mcp.a.headers" } },
    { "name": "an MCP server's env name with a hyphen", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\ncommand = \"x\"\n[mcp.a.env.A-B]\nvalue = \"1\"\n" } ], "error": { "layer": 0, "code": "name", "key": "mcp.a.env" } },
    { "name": "from_env naming no variable", "layers": [ { "kind": "user", "toml": "[env.A]\nfrom_env = \"A-B\"\n" } ], "error": { "layer": 0, "code": "name", "key": "env.A" } },
    { "name": "an overlay naming an absolute path", "layers": [ { "kind": "overlay", "name": "o", "toml": "[skills.r]\npath = \"/etc/skills\"\n" } ], "error": { "layer": 0, "code": "path", "key": "skills.r" } },
    { "name": "an overlay naming a Windows drive", "layers": [ { "kind": "overlay", "name": "o", "toml": "context = { file = \"C:/brief.md\" }\n" } ], "error": { "layer": 0, "code": "path", "key": "context" } },
    { "name": "an overlay stepping out of its directory", "layers": [ { "kind": "overlay", "name": "o", "toml": "[skills.r]\npath = \"skills/../../up\"\n" } ], "error": { "layer": 0, "code": "path", "key": "skills.r" } },
    { "name": "a project reading a file in the home directory", "layers": [ { "kind": "project", "toml": "[env.A]\nfrom_file = \"~/.ssh/id_ed25519\"\n" } ], "error": { "layer": 0, "code": "path", "key": "env.A" } },
    { "name": "a project naming a file by a backslash root", "layers": [ { "kind": "project", "toml": "[mcp.a]\ntype = \"http\"\nurl = \"https://x\"\n[mcp.a.headers.T]\nfrom_file = \"\\\\server\\\\share\\\\t\"\n" } ], "error": { "layer": 0, "code": "path", "key": "mcp.a.headers.T" } },
    { "name": "an empty path", "layers": [ { "kind": "user", "toml": "[skills.a]\npath = \"\"\n" } ], "error": { "layer": 0, "code": "path", "key": "skills.a" } },
    { "name": "an empty model", "layers": [ { "kind": "user", "toml": "model = \"\"\n" } ], "error": { "layer": 0, "code": "value", "key": "model" } },
    { "name": "a mode with a control character", "layers": [ { "kind": "user", "toml": "mode = \"plan\\u0007\"\n" } ], "error": { "layer": 0, "code": "value", "key": "mode" } },
    { "name": "an MCP URL that is not HTTP", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"http\"\nurl = \"file:///etc/passwd\"\n" } ], "error": { "layer": 0, "code": "value", "key": "mcp.a" } },
    { "name": "an argument holding NUL", "layers": [ { "kind": "user", "toml": "[mcp.a]\ntype = \"stdio\"\ncommand = \"x\"\nargs = [\"a\\u0000b\"]\n" } ], "error": { "layer": 0, "code": "value", "key": "mcp.a" } },
    { "name": "an empty context text", "layers": [ { "kind": "user", "toml": "context = { text = \"\" }\n" } ], "error": { "layer": 0, "code": "value", "key": "context" } },
    { "name": "the first refusal is the lowest layer's", "layers": [ { "kind": "built-in", "toml": "model = \"ok\"\n" }, { "kind": "user", "toml": "model = \"\"\n" }, { "kind": "session", "toml": "colour = 1\n" } ], "error": { "layer": 1, "code": "value", "key": "model" } }
  ],
  "sources": [
    { "source": "https://github.com/jose-pr/dotagents.git@repo#overlays/engineering", "repo": "https://github.com/jose-pr/dotagents.git", "ref": "repo", "path": "overlays/engineering" },
    { "source": "git@github.com:org/profiles.git@v1.2", "repo": "git@github.com:org/profiles.git", "ref": "v1.2", "path": "" },
    { "source": "/srv/git/profiles.git@main", "repo": "/srv/git/profiles.git", "ref": "main", "path": "" },
    { "source": "file:///tmp/p.git@0123456789abcdef0123456789abcdef01234567#a/b", "repo": "file:///tmp/p.git", "ref": "0123456789abcdef0123456789abcdef01234567", "path": "a/b" },
    { "source": "ssh://git@host/x.git@feature/profiles#team", "repo": "ssh://git@host/x.git", "ref": "feature/profiles", "path": "team" },
    { "source": "https://x/y.git", "refused": true },
    { "source": "git@github.com:org/p.git", "refused": true },
    { "source": "ext::sh -c touch% /tmp/pwned@main", "refused": true },
    { "source": "fd::3@main", "refused": true },
    { "source": "-uhttps://x/y.git@main", "refused": true },
    { "source": "https://x/y.git@main#../up", "refused": true },
    { "source": "https://x/y.git@main#/abs", "refused": true },
    { "source": "https://x/y.git@main#a\\b", "refused": true },
    { "source": "https://x/y.git@main#", "refused": true },
    { "source": "https://x/y.git@-rf", "refused": true },
    { "source": "https://x/y.git@a..b", "refused": true },
    { "source": "https://x/y.git@a:b", "refused": true },
    { "source": "https://x/y.git@", "refused": true },
    { "source": "@main", "refused": true },
    { "source": "https://x y/z@main", "refused": true },
    { "source": "ftp://x/y@main", "refused": true }
  ]
}
