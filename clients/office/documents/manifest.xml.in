<?xml version="1.0" encoding="UTF-8"?>
<!-- Canoa for Word, Excel and PowerPoint: the add-in only (XML) manifest. Render it for an origin with clients/office/render.mjs (see its README). -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>{{ID}}</Id>
  <Version>{{VERSION}}</Version>
  <ProviderName>Boriken Dev</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Canoa"/>
  <Description DefaultValue="Chat with your agents, with the sessions of the open document first."/>
  <IconUrl DefaultValue="{{ORIGIN}}/office/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="{{ORIGIN}}/office/icon-64.png"/>
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
{{HOSTS}}
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="{{ORIGIN}}/office/taskpane.html{{KEY}}"/>
  </DefaultSettings>
  <!-- Read and write document: the address of the open document is what a session is tied to, and the tools the pane offers read it
       and, when the person allows a change in the pane, write to it. -->
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
