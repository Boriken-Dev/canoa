# Copy to .env (ignored by git). app/tool/build.py reads it; a variable already in the environment wins.
# Paths only; no values here are secrets.

# The Flutter SDK, when flutter is not on PATH.
#FLUTTER_ROOT=/opt/flutter

# The pub cache that holds the git dependencies (coqui_acp, coqui_web, ...) at the revisions in app/pubspec.lock.
# An offline build reads them from here and writes only into target/offline-pub-cache.
#PUB_CACHE=/home/me/.pub-cache

# A checkout or worktree of the deps branch. Without it, build.py adds a worktree of origin/deps (or deps)
# beside the repository, named <repository>-deps.
#CANOA_DEPS=/home/me/src/canoa-deps

# The Rust toolchain the app's native plugin builds the host library with.
#CARGO_HOME=/home/me/.cargo
#RUSTUP_HOME=/home/me/.rustup
