{
  "name": "canoa-sdk",
  "version": "0.0.0-alpha.1",
  "description": "Write a Canoa provider in JavaScript or TypeScript: one base class per kind",
  "license": "MPL-2.0",
  "author": "jose-pr",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boriken-Dev/canoa.git",
    "directory": "bindings/js/canoa-sdk"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./account": {
      "types": "./types/account.d.ts",
      "import": "./src/account.js"
    },
    "./gateway": {
      "types": "./types/gateway.d.ts",
      "import": "./src/gateway.js"
    },
    "./vendor": {
      "types": "./types/vendor.d.ts",
      "import": "./src/vendor.js"
    },
    "./store": {
      "types": "./types/store.d.ts",
      "import": "./src/store.js"
    },
    "./speech": {
      "types": "./types/speech.d.ts",
      "import": "./src/speech.js"
    },
    "./secret": {
      "types": "./types/secret.d.ts",
      "import": "./src/secret.js"
    },
    "./profile": {
      "types": "./types/profile.d.ts",
      "import": "./src/profile.js"
    },
    "./source": {
      "types": "./types/source.d.ts",
      "import": "./src/source.js"
    },
    "./content": {
      "types": "./types/content.d.ts",
      "import": "./src/content.js"
    },
    "./section": {
      "types": "./types/section.d.ts",
      "import": "./src/section.js"
    },
    "./notifier": {
      "types": "./types/notifier.d.ts",
      "import": "./src/notifier.js"
    },
    "./panel": {
      "types": "./types/panel.d.ts",
      "import": "./src/panel.js"
    },
    "./viewer": {
      "types": "./types/viewer.d.ts",
      "import": "./src/viewer.js"
    },
    "./telemetry": {
      "types": "./types/telemetry.d.ts",
      "import": "./src/telemetry.js"
    },
    "./usage": {
      "types": "./types/usage.d.ts",
      "import": "./src/usage.js"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "import": "./src/forms.js"
    },
    "./kinds": {
      "types": "./types/kinds.d.ts",
      "import": "./src/kinds.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "node tools/typecheck.mjs --types types",
    "typecheck": "node tools/typecheck.mjs",
    "unit": "node --import ./tools/guatiao_hook.mjs --test --test-timeout=60000 test/*.test.mjs",
    "test": "node tools/typecheck.mjs --types && npm run unit"
  },
  "peerDependencies": {
    "guatiao": "*"
  },
  "peerDependenciesMeta": {
    "guatiao": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
