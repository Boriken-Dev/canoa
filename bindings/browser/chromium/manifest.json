{
  "manifest_version": 3,
  "name": "Canoa",
  "version": "0.0.1",
  "description": "Multi-session ACP chat and browser MCP tools.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "alarms", "sidePanel", "contextMenus", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "permissions.html", "open_in_tab": true },
  "icons": { "16": "icons/canoa-16.png", "32": "icons/canoa-32.png", "48": "icons/canoa-48.png", "128": "icons/canoa-128.png" },
  "action": { "default_title": "Canoa", "default_icon": { "16": "icons/canoa-16.png", "32": "icons/canoa-32.png" } },
  "side_panel": { "default_path": "ui/index.html?view=panel" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
