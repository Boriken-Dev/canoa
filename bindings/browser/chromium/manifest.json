{
  "manifest_version": 3,
  "name": "Canoa",
  "version": "0.0.1",
  "description": "Connect browser applications and agent peers with user-managed permissions.",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Canoa" }
}
